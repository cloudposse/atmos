[1.537849292,"o","\u001b[38;5;231m- \u001b[0m\u001b[38;5;212minterpreter\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;231mstarlark\u001b[0m\u001b[38;5;231m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;231m  \u001b[0m\u001b[38;5;212mname\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;231mplan\u001b[0m\u001b[38;5;231m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;231m  \u001b[0m\u001b[38;5;212moutput\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;231mraw\u001b[0m\u001b[38;5;231m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;231m  \u001b[0m\u001b[38;5;212mscript\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;231m|\u001b[0m\u001b[38;5;228m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m    load(\"components.star\", \"plan_component\")\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m    def release_plan():\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        selected = ctx.component\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        print(\"Release plan for {} in {}\".format(selected.name, selected.stack))\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        results = steps.parallel(\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m            tasks = [\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                steps.task(\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                    name = name,\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                    function = plan_component,\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                    args = [name, selected.stack],\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                    retry = {\"max_attempts\": 3, \"initial_delay\": \"100ms\"},\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                    timeout = \"10s\",\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                )\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                for name in selected.settings[\"release_components\"]\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m            ],\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m            max_concurrency = 2,\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        )\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        for result in results:\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m            print(\"  {}: v{} | replicas={} | region={}\".format(\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m                result[\"name\"], result[\"version\"], result[\"replicas\"], result[\"region\"],\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m            ))\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        ui.success(\"All {} component plans ready. No infrastructure changed.\".format(len(results)))\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m        return results\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;228m    output = release_plan()\u001b[0m\u001b[38;5;231m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;231m  \u001b[0m\u001b[38;5;212mshow\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m\u001b[0m\n"]
[0.012,"o","\u001b[38;5;231m    \u001b[0m\u001b[38;5;212mlabels\u001b[0m\u001b[38;5;231m:\u001b[0m\u001b[38;5;231m \u001b[0m\u001b[38;5;212mfalse\u001b[0m\u001b[38;5;231m\u001b[0m\n"]
