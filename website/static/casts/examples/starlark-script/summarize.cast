[0.004117708,"o","#!/usr/bin/env atmos\n"]
[0.012,"o","# Read structured data without installing another interpreter.\n"]
[0.012,"o","if len(ctx.args) != 1:\n"]
[0.012,"o","    fail(\"usage: ./summarize.star services.json\")\n"]
[0.012,"o","\n"]
[0.012,"o","def total_replicas(services):\n"]
[0.012,"o","    total = 0\n"]
[0.012,"o","    for service in services:\n"]
[0.012,"o","        total += service[\"replicas\"]\n"]
[0.012,"o","    return total\n"]
[0.012,"o","\n"]
[0.012,"o","services = json.decode(fs.read_file(ctx.args[0]))\n"]
[0.012,"o","for service in services:\n"]
[0.012,"o","    print(\"{}: {} replicas\".format(service[\"name\"], service[\"replicas\"]))\n"]
[0.012,"o","print(\"Total: {} services, {} replicas\".format(\n"]
[0.012,"o","    len(services),\n"]
[0.012,"o","    total_replicas(services),\n"]
[0.012,"o","))\n"]
