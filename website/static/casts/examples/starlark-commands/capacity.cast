[0.00638175,"o","base_path: .\n"]
[0.012,"o","\n"]
[0.012,"o","commands:\n"]
[0.012,"o","  - name: capacity\n"]
[0.012,"o","    description: Calculate a service's total worker capacity\n"]
[0.012,"o","    flags:\n"]
[0.012,"o","      - name: replicas\n"]
[0.012,"o","        type: string\n"]
[0.012,"o","        default: \"2\"\n"]
[0.012,"o","        description: Number of service replicas\n"]
[0.012,"o","    steps:\n"]
[0.012,"o","      - name: capacity\n"]
[0.012,"o","        type: script\n"]
[0.012,"o","        interpreter: starlark\n"]
[0.012,"o","        show:\n"]
[0.012,"o","          labels: false\n"]
[0.012,"o","        script: |\n"]
[0.012,"o","          replicas = int(ctx.flags[\"replicas\"])\n"]
[0.012,"o","          if replicas \u003c 1:\n"]
[0.012,"o","              fail(\"replicas must be positive\")\n"]
[0.012,"o","          workers_per_replica = 4\n"]
[0.012,"o","          ui.success(\"{} replicas x {} workers = {} workers\".format(\n"]
[0.012,"o","              replicas, workers_per_replica, replicas * workers_per_replica,\n"]
[0.012,"o","          ))\n"]
