[0.002098708,"o","\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThis command executes \u001b[0m\u001b[38;2;0;255;255;1maws eks update-kubeconfig\u001b[0m\u001b[38;2;247;250;252m to download \u001b[0m\u001b[38;2;0;255;255;1mkubeconfig\u001b[0m\u001b[38;2;247;250;252m from an EKS\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mcluster and saves it to a file. The command executes \u001b[0m\u001b[38;2;0;255;255;1maws eks update-kubeconfig\u001b[0m\u001b[38;2;247;250;252m in\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mthree\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mdifferent\u001b[0m\u001b[38;2;247;250;252m ways:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m1\u001b[0m\u001b[38;2;247;250;252m. \u001b[0m\u001b[38;2;247;250;252mIf all the required parameters (cluster name and AWS profile/role) are provided on\u001b[0m\n\u001b[38;2;73;85;104m   \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthe\u001b[0m\u001b[38;2;247;250;252m command-line,\u001b[0m\n\u001b[38;2;73;85;104m   \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthen \u001b[0m\u001b[38;2;0;255;255;1matmos\u001b[0m\u001b[38;2;247;250;252m executes the command without requiring the \u001b[0m\u001b[38;2;0;255;255;1matmos.yaml\u001b[0m\u001b[38;2;247;250;252m CLI config and\u001b[0m\n\u001b[38;2;73;85;104m   \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mcontext.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m2\u001b[0m\u001b[38;2;247;250;252m. \u001b[0m\u001b[38;2;247;250;252mIf 'component' and 'stack' are provided on the\u001b[0m\u001b[38;2;247;250;252m command-line,\u001b[0m\n\u001b[38;2;73;85;104m   \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthen \u001b[0m\u001b[38;2;0;255;255;1matmos\u001b[0m\u001b[38;2;247;250;252m executes the command using the \u001b[0m\u001b[38;2;0;255;255;1matmos.yaml\u001b[0m\u001b[38;2;247;250;252m CLI config and stack's context by\u001b[0m\n\u001b[38;2;73;85;104m   \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252msearching for the following\u001b[0m\u001b[38;2;247;250;252m settings:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m• \u001b[0m\u001b[38;2;247;250;252m'components.helmfile.cluster_\u001b[0m\u001b[38;2;247;250;252mname_\u001b[0m\u001b[38;2;247;250;252mtemplate' in the 'atmos.yaml' CLI config (and\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mcalculates the '--name' parameter using the Go template; the deprecated 'components.\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mhelmfile.cluster_\u001b[0m\u001b[38;2;247;250;252mname_\u001b[0m\u001b[38;2;247;250;252mpattern' token syntax also\u001b[0m\u001b[38;2;247;250;252m works)\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m• \u001b[0m\u001b[38;2;247;250;252m'components.helmfile.helm_\u001b[0m\u001b[38;2;247;250;252maws_\u001b[0m\u001b[38;2;247;250;252mprofile_\u001b[0m\u001b[38;2;247;250;252mpattern' in the 'atmos.yaml' CLI config (and\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mcalculates the \u001b[0m\u001b[38;2;0;255;255;1m--profile\u001b[0m\u001b[38;2;247;250;252m parameter using the\u001b[0m\u001b[38;2;247;250;252m pattern)\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\