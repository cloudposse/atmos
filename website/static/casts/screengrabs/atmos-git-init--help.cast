[0.002108708,"o","\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mInitialize a named repository (configured under git.repositories) whose\u001b[0m\u001b[38;2;247;250;252m remote \u001b[0m\u001b[38;2;247;250;252mhas no\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mcontent yet — the inverse of\u001b[0m\u001b[38;2;247;250;252m clone.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWithout --from, an empty repository is created at the resolved workdir on\u001b[0m\u001b[38;2;247;250;252m the\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mconfigured\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mbranch, with the configured remote wired up, ready\u001b[0m\u001b[38;2;247;250;252m for \u001b[0m\u001b[38;2;247;250;252m'atmos git commit' and 'atmos\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mgit\u001b[0m\u001b[38;2;247;250;252m push'.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWith --from=\u001b[0m\u001b[38;2;247;250;252m, the new repository is seeded from another\u001b[0m\u001b[38;2;247;250;252m repository:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m• \u001b[0m\u001b[38;2;247;250;252mDefault (fresh history): the source content is imported as a single\u001b[0m\u001b[38;2;247;250;252m fresh\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252minitial commit; no link to the source\u001b[0m\u001b[38;2;247;250;252m remains.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m• \u001b[0m\u001b[38;2;247;250;252mWith --keep-history: the source's full history is preserved and the\u001b[0m\u001b[38;2;247;250;252m source\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mstays reachable as the 'upstream' remote, so future updates can be\u001b[0m\u001b[38;2;247;250;252m pulled.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThe seed source can also be configured per repository\u001b[0m\u001b[38;2;247;250;252m under \u001b[0m\u001b[38;2;247;250;252mgit.repositories.\u001b[0m\u001b[38;2;247;250;252m.init\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m(from, keep_\u001b[0m\u001b[38;2;247;250;252mhistory); the --from and\u001b[0m\u001b[38;2;247;250;252m --keep-history \u001b[0m\u001b[38;2;247;250;252mflags override the configured\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mdefaults.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWhen no argument is provided, Atmos initializes the single configured\u001b[0m\u001b[38;2;247;250;252m repository.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mArguments after -- are passed verbatim to the underlying git\u001b[0m\u001b[38;2;247;250;252m invocation \u001b[0m\u001b[38;2;247;250;252m(git init, or\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthe git clone of\u001b[0m\u001b[38;2;247;250;252m --from): \u001b[0m\u001b[38;2;