[0.000004458,"o","      \u001b[38;2;73;85;104m-out\u001b[0m                  \u001b[38;2;255;255;255mWrite the plan to the given path\u001b[0m\n"]
[0.000005542,"o","      \u001b[38;2;73;85;104m-parallelism\u001b[0m          \u001b[38;2;255;255;255mLimit the number of concurrent operations (default: 10)\u001b[0m\n"]
[0.00000675,"o","      \u001b[38;2;73;85;104m-refresh\u001b[0m              \u001b[38;2;255;255;255mUpdate state prior to checking for differences (default: true)\u001b[0m\n"]
