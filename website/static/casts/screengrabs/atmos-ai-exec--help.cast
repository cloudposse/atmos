01b[0m\u001b[38;2;247;250;252mtool_\u001b[0m\u001b[38;2;247;250;252miterations, default 25) was reached. A tool\u001b[0m\u001b[38;2;247;250;252m call\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthat fails but returns a normal error result (e.g. a file not found) is\u001b[0m\u001b[38;2;247;250;252m fed\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mback to the model to retry or work around, and does not by itself cause\u001b[0m\u001b[38;2;247;250;252m exit\u001b[0m\n\u001b[38;2;73;85;104m  \u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mcode\u001b[0m\u001b[38;2;247;250;252m 2.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mExamples:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m\u001b[0m  \u001b[38;2;26;32;44;48;2;0;163;224;1m \u001b[0m\u001b[38;2;247;250;252;48;2;0;163;224;1mSimple\u001b[0m\u001b[38;2;247;250;252;48;2;0;163;224;1m question\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m \u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252matmos ai exec \"List all available\u001b[0m\u001b[38;2;247;250;252m stacks\"\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m\u001b[0m  \u001b[38;2;26;32;44;48;2;0;163;224;1m \u001b[0m\u001b[38;2;247;250;252;48;2;0;163;224;1mWith JSON\u001b[0m\u001b[38;2;247;250;252;48;2;0;163;224;1m output\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m \u001b[0m\n\u001b[38;2;73;85;104m\u001