[0.002136209,"o","\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWrite shim scripts into .git/hooks for each configured git.hooks\u001b[0m\u001b[38;2;247;250;252m entry.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWithout hook names, installs all configured\u001b[0m\u001b[38;2;247;250;252m hooks. \u001b[0m\u001b[38;2;247;250;252mWith hook names, installs only the\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mnamed hooks (error if not\u001b[0m\u001b[38;2;247;250;252m configured).\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mEach shim runs the named hook through \"atmos git hooks run\", preserving Git's\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252marguments. \u001b[0m\u001b[38;2;247;250;252mIt prefers the current worktree's executable build/atmos (or\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mbuild/atmos.exe). \u001b[0m\u001b[38;2;247;250;252mDevelopment builds are never pinned into shared hooks: without a\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mlocal\u001b[0m\u001b[38;2;247;250;252m build, \u001b[0m\u001b[38;2;247;250;252mthe shim uses atmos on PATH. System installations retain their absolute\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mpath \u001b[0m\u001b[38;2;247;250;252mas a fallback for GUI clients, then try PATH if that binary is\u001b[0m\u001b[38;2;247;250;252m unavailable. \u001b[0m\u001b[38;2;247;250;252mRe-\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mrun\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252minstall to upgrade an existing Atmos\u001b[0m\u001b[38;2;247;250;252m shim.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mEach hook is validated before any shim is written: it must set exactly one\u001b[0m\u001b[38;2;247;250;252m of \u001b[0m\u001b[38;2;247;250;252mcommand\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mor a non-empty steps list, and its steps must be valid. Names that\u001b[0m\u001b[38;2;247;250;252m Git \u001b[0m\u001b[38;2;247;250;252mnever invokes\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mproduce a warning. Re-running install leaves unchanged shims as\u001b[0m\u001b[38;2;247;250;252m is.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mRefuses to overwrite an existing hook unless --force is passed, unless\u001b[0m\u001b[38;2;247;250;252m the \u001b[0m\u001b[38;2;247;250;252mexisting\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mfile\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252malready contains the Atmos\u001b[0m\u001b[38;2;247;250;252m marker.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m--force backs up recognized pre-commit framework hooks before replacing\u001b[0m\u001b[38;2;247;250;252m them. \u001b[0m\u001b[38;2;247;250;252mIt\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mreplaces\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthe installed launcher; it does not convert\u001b[0m\u001b[38;2;247;250;252m .pre-commit-config.yaml.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mRefuses installation when core.hooksPath is configured, even with --force,\u001b[0m\u001b[38;2;247;250;252m to \u001b[0m\u001b[38;2;247;250;252mpreserve\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mhook directories managed by other\u001b[0m\u001b[38;2;247;250;252m tools.\u001b[0m\n"]
