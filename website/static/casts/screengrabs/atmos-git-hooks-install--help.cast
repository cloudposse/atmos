[0.002531083,"o","\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWrite shim scripts into .git/hooks for each configured git.hooks\u001b[0m\u001b[38;2;247;250;252m entry.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWithout hook names, installs all configured\u001b[0m\u001b[38;2;247;250;252m hooks. \u001b[0m\u001b[38;2;247;250;252mWith hook names, installs only the\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mnamed hooks (error if not\u001b[0m\u001b[38;2;247;250;252m configured).\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThe shim content for the pre-commit hook\u001b[0m\u001b[38;2;247;250;252m is:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m#\u001b[0m\u001b[38;2;247;250;252m!/bin/sh\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m\u001b[0m  \u001b[38;2;26;32;44;48;2;0;163;224;1m \u001b[0m\u001b[38;2;247;250;252;48;2;0;163;224;1mGenerated by Atmos. Do not\u001b[0m\u001b[38;2;247;250;252;48;2;0;163;224;1m edit.\u001b[0m\u001b[38;2;26;32;44;48;2;0;163;224;1m \u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mexec atmos git hooks run pre-commit\u001b[0m\u001b[38;2;247;250;252m \"$@\"\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThe hook name (here \"pre-commit\") follows\u001b[0m\u001b[38;2;247;250;252m \"run\".\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mEach hook is validated before any shim is written: it must set exactly one\u001b[0m\u001b[38;2;247;250;252m of \u001b[0m\u001b[38;2;247;250;252mcommand\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mor a non-empty steps list, and its steps must be valid. Names that\u001b[0m\u001b[38;2;247;250;252m Git \u001b[0m\u001b[38;2;247;250;252mnever invokes\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mproduce a warning. Re-running install leaves unchanged shims as\u001b[0m\u001b[38;2;247;250;252m is.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mRefuses to overwrite an existing hook unless --force is passed, unless\u001b[0m\u001b[38;2;247;250;252m the \u001b[0m\u001b[38;2;247;250;252mexisting\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mfile\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252malready contains the Atmos\u001b[0m\u001b[38;2;247;250;252m marker.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m--force backs up recognized pre-commit framework hooks before replacing\u001b[0m\u001b[38;2;247;250;252m them. \u001b[0m\u001b[38;2;247;250;252mIt\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mreplaces\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mthe installed launcher; it does not convert\u001b[0m\u001b[38;2;247;250;252m .pre-commit-config.yaml.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWarns (but does not fail) when core.hooksPath is set, because Git will\u001b[0m\u001b[38;2;247;250;252m ignore\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m.git/hooks shims in that\u001b[0m\u001b[38;2;247;250;252m case.\u001b[0m\n"]
