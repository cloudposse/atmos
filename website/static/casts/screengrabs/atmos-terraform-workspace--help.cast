[0.0017655,"o","\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mManage Terraform workspaces for organizing multiple states within a single\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mconfiguration.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThe 'atmos terraform workspace' command initializes Terraform for the current\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mconfiguration, \u001b[0m\u001b[38;2;247;250;252mselects the specified workspace, and creates it if it does not already\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mexist.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mIt runs the following sequence of Terraform\u001b[0m\u001b[38;2;247;250;252m commands:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m1\u001b[0m\u001b[38;2;247;250;252m. \u001b[0m\u001b[38;2;247;250;252m'terraform init -reconfigure' to initialize the working\u001b[0m\u001b[38;2;247;250;252m directory.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m2\u001b[0m\u001b[38;2;247;250;252m. \u001b[0m\u001b[38;2;247;250;252m'terraform workspace select' to switch to the specified\u001b[0m\u001b[38;2;247;250;252m workspace.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m3\u001b[0m\u001b[38;2;247;250;252m. \u001b[0m\u001b[38;2;247;250;252mIf the workspace does not exist, it runs 'terraform workspace new' to create and\u001b[0m\n\u001b[38;2;73;85;104m   \u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mselect\u001b[0m\u001b[38;2;247;250;252m it.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThis ensures that the workspace is properly set up for Terraform\u001b[0m\u001b[38;2;247;250;252m operations.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mFor complete Terraform/OpenTofu documentation,\u001b[0m\u001b[38;2;247;250;252m see:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;0;163;224;4m\u001b[0m\u001b[38;2;0;163;224;4m\u001b[0m  \u001b[38;2;0;163;224;4mhttps://developer.hashicorp.com/terraform/cli/commands/workspace\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;0;163;224;4m\u001b[0m\u001b[38;2;0;163;224;4m\u001b[0m  \u001b[38;2;0;163;224;4mhttps://opentofu.org/docs/cli/commands/workspace\u001b[0m\n"]
