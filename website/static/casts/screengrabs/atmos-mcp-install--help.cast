[0.00251325,"o","\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mInstall MCP servers configured in \u001b[0m\u001b[38;2;0;255;255;1matmos.yaml\u001b[0m\u001b[38;2;247;250;252m into MCP-capable AI\u001b[0m\u001b[38;2;247;250;252m clients.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mThe command reads \u001b[0m\u001b[38;2;0;255;255;1mmcp.servers\u001b[0m\u001b[38;2;247;250;252m and writes the appropriate client config\u001b[0m\u001b[38;2;247;250;252m across \u001b[0m\u001b[38;2;247;250;252m15\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252msupported AI clients (see \u001b[0m\u001b[38;2;0;255;255;1m--client\u001b[0m\u001b[38;2;247;250;252m below). Both local stdio servers\u001b[0m\u001b[38;2;247;250;252m and \u001b[0m\u001b[38;2;247;250;252mremote HTTP\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mservers are\u001b[0m\u001b[38;2;247;250;252m supported.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;247;250;252m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mWhen neither \u001b[0m\u001b[38;2;0;255;255;1m--scope\u001b[0m\u001b[38;2;247;250;252m nor \u001b[0m\u001b[38;2;0;255;255;1m--global\u001b[0m\u001b[38;2;247;250;252m is given and the command is running in\u001b[0m\u001b[38;2;247;250;252m an\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252minteractive\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mterminal, Atmos prompts you to choose project or user scope; \u001b[0m\u001b[38;2;0;255;255;1m--yes\u001b[0m\u001b[38;2;247;250;252m, \u001b[0m\u001b[38;2;247;250;252ma non-TTY session,\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m  \u001b[38;2;247;250;252mor\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252mCI skips the prompt and defaults to \u001b[0m\u001b[38;2;0;255;255;1mproject\u001b[0m\u001b[38;2;247;250;252m.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;2;155;81;224;1m\u001b[0m\u001b[38;2;155;81;224;1m\u001b[0m  \u001b[38;2;155;81;224;1mExamples:\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;5;240m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;5;240m# Install all configured MCP servers into detected project clients.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;5;231m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;5;231matmos mcp install\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;5;240m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;5;240m# Install one server into Cursor and Claude Code project configs.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;5;231m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;5;231matmos mcp install aws-docs --client cursor --client claude-code\u001b[0m\n\u001b[38;2;73;85;104m\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;5;240m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;5;240m# Install into user-level config.\u001b[0m\n\u001b[38;2;73;85;104m\u001b[38;5;231m\u001b[0m\u001b[38;2;247;250;252m\u001b[0m  \u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;2;247;250;252m \u001b[0m\u001b[38;5;23