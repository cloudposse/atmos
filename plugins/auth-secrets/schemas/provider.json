{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentials"
  ],
  "properties": {
    "credentials": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "store",
          "key"
        ],
        "properties": {
          "store": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "stack": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependentRequired": {
          "stack": [
            "component"
          ],
          "component": [
            "stack"
          ]
        }
      }
    }
  }
}
