[
  {
    "id": "context",
    "template": "{{ .vars.stage }}"
  },
  {
    "id": "sprig-functions",
    "template": "{{ upper \"hello\" }}|{{ default \"fallback\" \"\" }}|{{ add 2 3 }}"
  },
  {
    "id": "sprig-collisions",
    "template": "{{ contains \"ell\" \"hello\" }}|{{ hasPrefix \"he\" \"hello\" }}|{{ trim \" a \" }}|{{ splitList \",\" \"a,b\" | toJson }}"
  },
  {
    "id": "builtin-slice",
    "template": "{{ slice (list \"a\" \"b\" \"c\") 1 3 | toJson }}"
  },
  {
    "id": "conv-bool",
    "template": "{{ printf \"%T:%v\" (conv.Bool \"true\") (conv.Bool \"true\") }}"
  },
  {
    "id": "conv-slice",
    "template": "{{ printf \"%T\" (conv.Slice \"a\" 2 true) }}|{{ conv.Slice \"a\" 2 true | toJSON }}"
  },
  {
    "id": "conv-dict",
    "template": "{{ printf \"%T\" (conv.Dict \"name\" \"test\" \"count\" 2) }}|{{ conv.Dict \"name\" \"test\" \"count\" 2 | toJSON }}"
  },
  {
    "id": "conv-has",
    "template": "{{ conv.Has (dict \"a\" 1) \"a\" }}|{{ conv.Has (dict \"a\" 1) \"b\" }}"
  },
  {
    "id": "conv-int64",
    "template": "{{ printf \"%T:%v\" (conv.ToInt64 \"42\") (conv.ToInt64 \"42\") }}"
  },
  {
    "id": "conv-int",
    "template": "{{ printf \"%T:%v\" (conv.ToInt \"42\") (conv.ToInt \"42\") }}"
  },
  {
    "id": "conv-float",
    "template": "{{ printf \"%T:%v\" (conv.ToFloat64 \"1.25\") (conv.ToFloat64 \"1.25\") }}"
  },
  {
    "id": "conv-atoi",
    "template": "{{ printf \"%T:%v\" (conv.Atoi \"42\") (conv.Atoi \"42\") }}"
  },
  {
    "id": "conv-int64-invalid",
    "template": "{{ conv.ToInt64 \"invalid\" }}"
  },
  {
    "id": "conv-int-invalid",
    "template": "{{ conv.ToInt \"invalid\" }}"
  },
  {
    "id": "conv-float-invalid",
    "template": "{{ conv.ToFloat64 \"invalid\" }}"
  },
  {
    "id": "conv-atoi-invalid",
    "template": "{{ conv.Atoi \"invalid\" }}"
  },
  {
    "id": "strings-sort",
    "template": "{{ strings.Sort (conv.Slice \"b\" \"a\") | toJSON }}"
  },
  {
    "id": "net-ip",
    "template": "{{ printf \"%T:%v\" (net.ParseIP \"192.0.2.1\") (net.ParseIP \"192.0.2.1\") }}|{{ (net.ParseIP \"192.0.2.1\").As4 }}"
  },
  {
    "id": "net-prefix",
    "template": "{{ printf \"%T:%v\" (net.ParseIPPrefix \"192.0.2.0/24\") (net.ParseIPPrefix \"192.0.2.0/24\") }}"
  },
  {
    "id": "net-range",
    "template": "{{ printf \"%T:%v\" (net.ParseIPRange \"192.0.2.1-192.0.2.3\") (net.ParseIPRange \"192.0.2.1-192.0.2.3\") }}"
  },
  {
    "id": "data-json-types",
    "template": "{{ $d := data.JSON `{\"n\":42,\"b\":true,\"a\":[1,2]}` }}{{ printf \"%T/%T/%T\" $d.n $d.b $d.a }}|{{ $d | toJSON }}"
  },
  {
    "id": "data-yaml-types",
    "template": "{{ $d := data.YAML \"n: 42\\nb: true\\na: [1, 2]\" }}{{ printf \"%T/%T/%T\" $d.n $d.b $d.a }}|{{ $d | toJSON }}"
  },
  {
    "id": "env",
    "template": "{{ getenv \"COMPAT_VALUE\" }}"
  },
  {
    "id": "parse-error",
    "template": "{{ if }}",
    "baseline_exit": 1
  },
  {
    "id": "unknown-function",
    "template": "{{ functionDoesNotExist }}",
    "baseline_exit": 1
  },
  {
    "id": "net-ip-invalid",
    "template": "{{ net.ParseIP \"invalid\" }}",
    "baseline_exit": 1
  },
  {
    "id": "sprig-disabled-aliases",
    "template": "{{ contains \"hello\" \"ell\" }}|{{ hasPrefix \"hello\" \"he\" }}|{{ split \"a,b\" \",\" | toJSON }}|{{ splitN \"a,b,c\" \",\" 2 | toJSON }}",
    "settings": {
      "sprig": {
        "enabled": false
      }
    }
  },
  {
    "id": "missing-key",
    "template": "{{ .vars.missing }}"
  },
  {
    "id": "gomplate-disabled",
    "template": "{{ upper \"hello\" }}",
    "settings": {
      "gomplate": {
        "enabled": false
      }
    }
  },
  {
    "id": "custom-delimiters",
    "template": "[[ strings.ToUpper \"hello\" ]]",
    "settings": {
      "delimiters": [
        "[[",
        "]]"
      ]
    }
  },
  {
    "id": "file-json",
    "template": "{{ $d := datasource \"cfg\" }}{{ printf \"%T/%T/%T\" $d.count $d.enabled $d.items }}|{{ $d | toJSON }}",
    "settings": {
      "gomplate": {
        "datasources": {
          "cfg": {
            "url": "@DATA_URI@/config.json"
          }
        }
      }
    }
  },
  {
