# yaml-language-server: $schema=https://atmos.tools/schemas/atmos/atmos-manifest/1.0/atmos-manifest.json
#
# This fixture is a deliberately isolated sibling of
# tests/fixtures/scenarios/atmos-include-yaml-function/: atmos's name_template-based stack
# resolution parses (and evaluates every custom YAML function in) every manifest matched by
# included_paths whenever ANY stack in a fixture is resolved -- not just the one requested via
# -s. That fixture's stacks/deploy/nonprod.yaml has a live, unconditional
# https://raw.githubusercontent.com/... !include (see that file's own comment) which stays
# untouched as a real-network case, so co-locating a mock-routed stack alongside it would still
# force a live fetch on every resolution, network or not. This directory exists solely so the
# mock-routed !include below is never forced to share a stack-manifest scan with that live file.
import:
  - mixins/stage/nonprod-mock

# Download the remote file using `go-getter` and assign the `components.terraform.component-1.settings` section
# from the file to the `settings` section` in the current stack.
#
# The URL's host is the mock's own dynamic address, filled in below via a Go template
# expression reading the ATMOS_TEST_GITHUB_MOCK_URL environment variable -- the process-wide
# httpmock GitHub facade TestMain starts and exports (see tests/cli_test.go and the "!include
# function test (mock GitHub)" case in tests/test-cases/atmos-include-yaml-function.yaml, which
# also points GITHUB_SERVER_URL/GITHUB_API_URL at it) -- not a literal "github.com" URL like the
# sibling live fixture's case uses. pkg/github.ConvertToRawURL (invoked by
# pkg/utils/yaml_include_by_extension.go's processRemoteFile) deliberately always resolves an
# explicit "github.com" URL against public github.com, even when GITHUB_SERVER_URL points
# elsewhere -- correct behavior for a real GitHub Enterprise Server user who links a public repo
# from a GHES stack (see pkg/github/client.go's ConvertToRawURL and its
# TestConvertToRawURL_ExplicitGitHubComWithGHESConfigured) -- so a literal "github.com" URL here
# would now bypass the mock and hit live GitHub instead. Routing this URL at the mock's own host
# makes pkg/utils/yaml_include_by_extension.go's isGitHubURL and ConvertToRawURL's endpoint
# matching recognize it as "the configured GitHub Enterprise Server host" instead, which resolves
# it via pkg/github.Endpoints.RawURL to the mock's GHES-shape /raw/<owner>/<repo>/<ref>/<path>
# route, exactly like a real GHES-hosted link would.
#
# This requires two things this fixture's file (not the sibling live fixture's) opts into:
#   - The .yaml.tmpl extension, so atmos renders the Go template expression below (pkg/function's
#     Go-template pass over the raw manifest text) before parsing YAML and executing !include --
#     !include is a PreMerge function; a plain .yaml file only gets this early template pass when
#     the stack manifest itself supplies template context (e.g. a locals section), which this
#     file doesn't need otherwise. See https://atmos.tools/core-concepts/stacks/imports#go-templates-in-imports.
#     Caution: this early pass renders the WHOLE file as a Go template, comments included, so a
#     literal double-brace sequence anywhere above (e.g. in a comment) would also be parsed --
#     avoid writing one there.
#   - pkg/github/endpoints.go's hostOf preserving a non-default port (fixed alongside this
#     fixture): the facade runs on a random httptest.NewServer port, and without that fix
#     Endpoints.Host would drop it, so IsHost/isGitHubURL could never match this URL back to the
#     configured GITHUB_SERVER_URL.
settings: !include '{{ env "ATMOS_TEST_GITHUB_MOCK_URL" }}/cloudposse/atmos/blob/main/tests/fixtures/scenarios/stack-templates-2/stacks/deploy/nonprod.yaml .components.terraform.component-1.settings'

components:
  terraform:
    component-1:
      metadata:
        component: yaml-functions
      vars:
        # The `config` folder is relative to the `base_path` setting in `atmos.yaml`
        string_var: !include config/vars.json .string_var
        boolean_var: !include config/vars.yaml .boolean_var
        list_var: !include config/vars.tfvars .list_var
        map_var: !include config/vars.tfvars .map_var
