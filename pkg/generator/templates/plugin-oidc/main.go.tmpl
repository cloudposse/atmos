package main

import (
"crypto/sha256"
"encoding/hex"
 "gopkg.in/yaml.v3"
_ "embed"

    "github.com/cloudposse/atmos/sdk/api"
    "github.com/cloudposse/atmos/sdk/plugin"
    pluginv1 "github.com/cloudposse/atmos/sdk/proto/atmos/plugin/v1"
)

const pluginName = "{{ .Config.plugin_name }}"

//go:embed plugin.yaml
var manifestData []byte

func main() {
var metadata struct { Metadata struct { Version string `yaml:"version"` } `yaml:"metadata"` }
 if err := yaml.Unmarshal(manifestData, &metadata); err != nil { panic("invalid embedded plugin manifest") }
 digest := sha256.Sum256(manifestData)
    plugin.Main(plugin.Config{
        Description: &pluginv1.DescribeResponse{
            PluginName: pluginName,
            PluginVersion: metadata.Metadata.Version,
ManifestDigest: "sha256:"+hex.EncodeToString(digest[:]),
            Services: []*pluginv1.ServiceVersionRange{
                {Service: "auth.provider", Min: 1, Max: 1},
                {Service: "auth.identity", Min: 1, Max: 1},
 {Service: "command", Min: 1, Max: 1},
            },
            Exports: []*pluginv1.Export{
                {Service: "auth.provider", Kind: pluginName},
                {Service: "auth.identity", Kind: pluginName + "-broker"},
 {Service: "command", Kind: "about"},
            },
        },
        Build: func(client *api.Client) plugin.Services {
            return plugin.Services{Provider: &provider{api: client}, Identity: &broker{api: client}, Commands: &commands{}}
        },
    })
}
