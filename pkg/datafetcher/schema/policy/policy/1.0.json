{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "error_event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_/-]*\\.([a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*|\\*)\\.error$"
    },
    "error_events": {
      "oneOf": [
        {
          "$ref": "#/$defs/error_event"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/error_event"
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "initial_delay": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "max_delay": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "max_elapsed_time": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "backoff_strategy": {
          "enum": [
            "constant",
            "linear",
            "exponential"
          ]
        },
        "multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "random_jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "title": "Atmos inline policy document",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "atmos/v1"},
    "kind": {"const": "Policy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "\\S"},
        "description": {"type": "string", "description": "Plain-English policy purpose; not an expression or denial reason."}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policies"],
      "properties": {
        "tools": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "hooks": {"type": "object", "additionalProperties": {"type": "object"}},
        "policies": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "\\S"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on", "action"],
            "properties": {
              "description": {"type": "string"},
              "on": {"oneOf": [{"enum": ["terraform.plan", "operation", "atmos.affected", "function", "command", "component.command", "source", "plugin", "file", "auth"]}, {"$ref": "#/$defs/error_events"}]},
              "allowed_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "engine": {"enum": ["cel", "starlark", "opa", "jsonschema"], "default": "cel"},
              "opa": {"type": "object", "additionalProperties": false, "required": ["query", "modules"], "properties": {"query": {"type": "string", "minLength": 1, "maxLength": 65536}, "modules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "rego_version": {"enum": [0, 1], "default": 0}}},
              "schema": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}, "target": {"enum": ["input", "context"], "default": "input"}}},
              "files": {"type": "object", "additionalProperties": false, "required": ["include"], "properties": {"include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
              "rule": {"type": "string", "minLength": 1, "maxLength": 65536},
              "action": {"enum": ["deny", "hooks", "require_approval", "retry"]},
              "approvals": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "provider", "spec"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "provider": {"const": "github-actions"},
                    "spec": {
                      "type": "object", "additionalProperties": false,
                      "required": ["reviewers", "minimum"],
                      "properties": {
                        "reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$"}},
                        "minimum": {"type": "integer", "minimum": 1}
                      }
                    }
                  }
                }
              },
              "reason": {"type": "string", "description": "Optional static Markdown explanation and suggested alternative, displayed when the rule denies an operation. No template or input interpolation."},
              "with": {"type": "object"},
              "match": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "tags": {"type": "array", "items": {"type": "string"}},
                  "labels": {"type": "object", "additionalProperties": {"type": "string"}},
                  "components": {"type": "array", "items": {"type": "string"}},
                  "stacks": {"type": "array", "items": {"type": "string"}},
                  "component_types": {"type": "array", "items": {"type": "string"}}
                }
              },
              "checks": {
                "type": "object", "maxProperties": 100,
                "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
                "additionalProperties": {
                  "type": "object", "additionalProperties": false, "required": ["kind"],
                  "properties": {
                    "kind": {"enum": ["semver", "date", "schedule"]},
                    "path": {"type": "string", "pattern": "^/"},
                    "constraint": {"type": "string"},
                    "format": {"enum": ["date", "date-time", "time"]},
                    "start": {"type": "string"}, "end": {"type": "string"},
                    "timezone": {"type": "string"},
                    "weekdays": {"type": "array", "items": {"enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]}},
                    "start_time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
                    "end_time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}
                  }
                }
              },
              "required_ci": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["provider", "schema", "dataset"],
                  "properties": {
                    "provider": {"type": "string", "minLength": 1},
                    "schema": {"type": "string", "minLength": 1},
                    "dataset": {"enum": ["metadata", "event", "facts"]},
                    "fact": {"type": "string", "minLength": 1}
                  }
                }
              },
              "hooks": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["ref", "event"],
                  "properties": {
                    "ref": {"type": "string", "minLength": 1},
                    "event": {"type": "string", "minLength": 1},
                    "required": {"type": "boolean"},
                    "require_success": {"type": "boolean"}
                  }
                }
              }
            },
            "allOf": [
              {"if": {"properties": {"action": {"const": "retry"}}}, "then": {"required": ["with"], "properties": {"on": {"$ref": "#/$defs/error_events"}, "with": {"$ref": "#/$defs/retry"}}}},
              {"if": {"properties": {"on": {"$ref": "#/$defs/error_events"}}}, "then": {"properties": {"action": {"enum": ["deny", "retry"]}}}},{"if": {"properties": {"on": {"const": "file"}}}, "then": {"required": ["files"]}, "else": {"not": {"required": ["files"]}}},
              {"if": {"required": ["engine"], "properties": {"engine": {"const": "opa"}}}, "then": {"required": ["opa"], "not": {"anyOf": [{"required": ["rule"]}, {"required": ["schema"]}]}}, "else": {"not": {"required": ["opa"]}}},
              {"if": {"required": ["engine"], "properties": {"engine": {"const": "jsonschema"}}}, "then": {"required": ["schema"], "not": {"anyOf": [{"required": ["rule"]}, {"required": ["opa"]}]}}, "else": {"not": {"required": ["schema"]}}},
              {"if": {"required": ["engine"], "properties": {"engine": {"enum": ["opa", "jsonschema"]}}}, "else": {"required": ["rule"]}},
              {"if": {"required": ["allowed_roots"]}, "then": {"properties": {"on": {"const": "source"}}}},{
              "if": {"properties": {"on": {"enum": ["atmos.affected", "function", "command", "source", "plugin", "file", "auth"]}}},
              "then": {"not": {"required": ["match"]}}
            }, {
              "if": {"properties": {"action": {"const": "hooks"}}},
              "then": {"required": ["hooks"], "properties": {"on": {"const": "operation"}}},
              "else": {"not": {"required": ["hooks"]}}
            }, {
              "if": {"properties": {"action": {"const": "require_approval"}}},
              "then": {"required": ["approvals"]},
              "else": {"not": {"required": ["approvals"]}}
            }]
          }
        }
      }
    }
  }
}
